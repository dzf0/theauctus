# ══════════════════════════════════════════════════════════════
# THEAUCTUS — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Auth (required) ──────────────────────────────────────────
NEXTAUTH_SECRET=your-random-secret-here
ADMIN_EMAILS=your@email.com,admin@email.com

# ── AI APIs (required for content generation) ────────────────
GEMINI_API_KEY=your-gemini-key
ELEVENLABS_API_KEY=your-elevenlabs-key
PEXELS_API_KEY=your-pexels-key

# ── Paddle (international payments) ─────────────────────────
# Get from: Paddle Dashboard → Developer tools → Authentication
NEXT_PUBLIC_PADDLE_ENV=sandbox                    # or "production"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...          # client-side token (safe to expose)
PADDLE_API_KEY=pdl_sdbx_apikey_...                # server-side API key (NEVER expose)
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_... # from Notification destination

# Paddle Subscription Price IDs (monthly + yearly for each tier)
# Create these in Paddle Dashboard → Catalog → Products
# Then paste the pri_... IDs here
PADDLE_PRICE_STARTER_MONTH=pri_01h...
PADDLE_PRICE_STARTER_YEAR=pri_01h...
PADDLE_PRICE_GROWTH_MONTH=pri_01h...
PADDLE_PRICE_GROWTH_YEAR=pri_01h...
PADDLE_PRICE_PRO_MONTH=pri_01h...
PADDLE_PRICE_PRO_YEAR=pri_01h...

# Legacy one-time credit pack price IDs (optional)
PADDLE_PRICE_STARTER=pri_01h...
PADDLE_PRICE_GROWTH=pri_01h...
PADDLE_PRICE_PRO=pri_01h...

# Legacy Paddle v1 vars (optional)
PADDLE_VENDOR_ID=your-vendor-id
PADDLE_CLIENT_TOKEN=your-client-token
PADDLE_WEBHOOK_SECRET=your-webhook-secret

# ── Razorpay (India payments) ────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TheAuctus <noreply@theauctus.in>

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.theauctus.in
